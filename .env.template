LLM_PROVIDER="gemini"
LLM_API_KEY="your-gemini-api-key"
LLM_MODEL="gemini/gemini-3.5-flash"

EMBEDDING_PROVIDER="gemini"
EMBEDDING_API_KEY="your-gemini-api-key"
EMBEDDING_MODEL="gemini/gemini-embedding-2"

SYSTEM_ROOT_DIRECTORY=".cognee_system"
DATA_ROOT_DIRECTORY=".cognee_data"
MOCK_EMBEDDING="true"

# Multi-key rotation (Milestone 14): comma-separated, no spaces
GEMINI_API_KEYS="key1,key2,key3"
OPENAI_API_KEYS="sk-key1,sk-key2"
GROQ_API_KEYS="gsk_key1,gsk_key2"

# Seconds a rate-limited key stays out of rotation (default 60)
KEY_COOLDOWN_SECONDS=60
