      "updated": 1783271024748,
      "link": null,
      "locked": false,
      "text": "\u2705 Real-Time: Scrapes live browser captions and yields checks in under 2 seconds.\n\n\u2705 Objective: Measures self-consistency\u2014evaluating a speaker solely against their own public statements.\n\n\u2705 Context-Aware: Uses Cognee's temporal graphs to retrieve prior assertions pre-dating the speech.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 12.8,
      "containerId": null,
      "originalText": "\u2705 Real-Time: Scrapes live browser captions and yields checks in under 2 seconds.\n\n\u2705 Objective: Measures self-consistency\u2014evaluating a speaker solely against their own public statements.\n\n\u2705 Context-Aware: Uses Cognee's temporal graphs to retrieve prior assertions pre-dating the speech.",
      "lineHeight": 1.25
    },
